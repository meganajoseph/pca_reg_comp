library(readr)
library(dplyr)
library(tidyr)
library(ggpubr)
df <- read_csv("data/export.csv")
View(df)
library(tidyverse)
df <- df %>%
select(StateAbbr, CountyName, CountyFIPS, LocationID,
TotalPopulation, MeasureID, Data_Value) %>%
pivot_wider(names_from = MeasureID, values_from = Data_Value) %>%
mutate(TotalPopulation = parse_number(TotalPopulation))
class(df$TotalPopulation)
df <- df %>%
select(StateAbbr, CountyName, CountyFIPS, LocationID,
TotalPopulation, MeasureID, Data_Value) %>%
pivot_wider(names_from = MeasureID, values_from = Data_Value)
View(df)
model <- lm(UNEMP ~ CROWD + AGE65 + BROAD + NOHSDP + REMNRTY + SNGPNT, data=df)
summary(model)
df <- read_csv("data/export.csv")
df <- df %>%
select(StateAbbr, CountyName, CountyFIPS, LocationID,
TotalPopulation, MeasureID, Data_Value) %>%
pivot_wider(names_from = MeasureID, values_from = Data_Value) %>%
drop_na()
model <- lm(UNEMP ~ CROWD + AGE65 + BROAD + NOHSDP + REMNRTY + SNGPNT, data=df)
summary(model)
X <- df %>%
select(c('CROWD', 'AGE65', 'BROAD', 'NOHSDP', 'REMNRTY', 'SNGPNT'))
pca <- prcomp(X, scale=T)
pca$rotation
var_explained <- pca$sdev**2 / sum(pca$sdev**2)
ggplot(data = data.frame(x = c(1:ncol(X)), y = var_explained),
mapping = aes(x = x, y = y)) + geom_line() +
xlab("PCs") + ylab("Variance Explained") + ggtitle("Scree Plot") +
ylim(0, 1) +
theme_pubr()
var_explained
sum(var_explained[1:3]
)
sum(var_explained[1:5])
sum(var_explained[1:4])
