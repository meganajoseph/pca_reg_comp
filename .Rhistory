library(dplyr)
library(tidyr)
library(ggpubr)
library(tidyverse)
library(readxl)
df <- read_excel("../data/clh_2023_tract_2_0.xlsx", sheet = "Data")
variables <- c(
"ACS_AVG_HH_SIZE", "ACS_PCT_DISABLE", "ACS_PCT_MALE", "ACS_PCT_NON_CITIZEN",
"ACS_PCT_ENGLISH", "ACS_PCT_HH_LIMIT_ENGLISH", "ACS_PCT_OTH_LANG",
"ACS_PCT_VET", "ACS_MEDIAN_AGE", "ACS_PCT_AGE_ABOVE65",
"ACS_PCT_AIAN", "ACS_PCT_ASIAN", "ACS_PCT_BLACK", "ACS_PCT_HISPANIC",
"ACS_PCT_MULT_RACE", "ACS_PCT_NHPI", "ACS_PCT_OTHER_RACE", "ACS_PCT_WHITE",
"ACS_PCT_CHILD_1FAM",
"ACS_PCT_AIAN_COMB", "ACS_PCT_ASIAN_COMB", "ACS_PCT_BLACK_COMB",
"ACS_PCT_NHPI_COMB", "ACS_PCT_WHITE_COMB",
"ACS_PCT_HH_NO_COMP_DEV", "ACS_PCT_HH_SMARTPHONE", "ACS_PCT_HH_INTERNET",
"ACS_PCT_HH_CELLULAR", "ACS_PCT_BACHELOR_DGR", "ACS_PCT_1UP_PERS_1ROOM",
"ACS_PCT_HU_SOLAR", "ACS_MEDIAN_YEAR_BUILT", "ACS_PCT_HU_NO_VEH",
"ACS_PCT_UNINSURED", "CRE_TOT_RISK0",
"ACS_PCT_DIVORCED_F", "ACS_PCT_DIVORCED_M",
"ACS_PCT_MARRIED_SP_AB_M", "ACS_PCT_MARRIED_SP_AB_F",
"ACS_PCT_MARRIED_SP_PR_F", "ACS_PCT_MARRIED_SP_PR_M",
"ACS_PCT_NVR_MARRIED_F", "ACS_PCT_NVR_MARRIED_M",
"ACS_PCT_WIDOWED_F", "ACS_PCT_WIDOWED_M", "ACS_MEDIAN_HH_INC"
)
df_selected <- df %>%
select(variables) %>%
drop_na() %>%
mutate(across(everything(), as.numeric))
ggplot(data=df_selected, aes(x=ACS_AVG_HH_SIZE, y=ACS_MEDIAN_HH_INC)) +
geom_point(color='plum4') +
labs(x="GDP", y="Robbery Rate", title="Comparison of robbery rate versus GDP (a)") +
theme_minimal()
ggplot(data=df_selected, aes(x=ACS_PCT_DISABLE, y=ACS_MEDIAN_HH_INC)) +
geom_point(color='plum4') +
theme_minimal()
for (var in variables) {}
for (var in variables) { ggplot(data=df_selected, aes(x=var, y=ACS_MDEIAN_HH_INC)) +
geom_point(color='plum4') +
labs(x=var, y="Median income") +
theme_minimal() }
for (var in variables) {
p <- ggplot(data = df_selected, aes(x = .data[[var]], y = ACS_MDEIAN_HH_INC)) +
geom_point(color = "plum4") +
labs(x = var, y = "Median income") +
theme_minimal()
print(p)
}
for (var in variables) {
p <- ggplot(data = df_selected, aes(x = .data[[var]], y = ACS_MEDIAN_HH_INC)) +
geom_point(color = "plum4") +
labs(x = var, y = "Median income") +
theme_minimal()
print(p)
}
library(patchwork)
plots <- lapply(variables, function(var) {
ggplot(df_selected, aes(x = .data[[var]], y = ACS_MDEIAN_HH_INC)) +
geom_point(color = "plum4", size = 1) +
labs(x = var, y = "Median income") +
theme_minimal()
})
wrap_plots(plots, ncol = 3)
plots <- lapply(variables, function(var) {
ggplot(df_selected, aes(x = .data[[var]], y = ACS_MEDIAN_HH_INC)) +
geom_point(color = "plum4", size = 1) +
labs(x = var, y = "Median income") +
theme_minimal()
})
wrap_plots(plots, ncol = 3)
plots <- lapply(variables, function(var) {
ggplot(df_selected, aes(x = .data[[var]], y = ACS_MEDIAN_HH_INC)) +
geom_point(color = "plum4", size = 1) +
labs(x = var, y = "Median income") +
theme_minimal()
})
