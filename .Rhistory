library(xml2)
library(xml2)
df <- read.delim('JPR robbery.tab', header = T, sep="\t")
ddi <- read_xml("JPR robbery-ddi.xml")   # use your file's name
xml_ns_strip(ddi)                  # removes the namespace so the paths below work
vars <- xml_find_all(ddi, ".//var")
data_dict <- data.frame(
name  = xml_attr(vars, "name"),
label = xml_text(xml_find_first(vars, "./labl")),
type  = xml_attr(xml_find_first(vars, "./varFormat"), "type")
)
View(ddi)
View(data_dict)
columns(df)
df.columns
library(tidycensus)
library(tidyverse)
census_api_key("469d08a6c20dca9eea4e84ee1ab86742620c8b96", install = TRUE)
readRenviron("~/.Renviron")
age_sex_educ_data_19 <- get_acs(
geography = "state",
table = "B15001",
state = "CA",
year = 2019,
survey = "acs1"
)
vars19 <- load_variables(2019, "acs1")
b15001_vars <- vars19 %>% filter(grepl("^B15001_", name))
with_labels <- left_join(age_sex_educ_data_19, b15001_vars, by=c("variable" = "name"))
labeled_clean <- with_labels %>%
separate_wider_delim(
label, delim = "!!",
names = c("estimate_type", "total", "sex", "age", "education"),
too_few = "align_start"
) %>%
select(-estimate_type, -total) %>%
mutate(across(c(sex, age, education), ~ str_remove(.x, ":$")))
write.csv(labeled_clean, "thesis/crosstab_2019.csv", row.names = FALSE)
